# ============================================================================
# ShelfSpace backend configuration
# Copy this file to `.env` and adjust the values. NEVER commit your `.env`.
# ============================================================================

# --- Application -----------------------------------------------------------
APP_NAME=ShelfSpace
ENVIRONMENT=development          # development | testing | production
DEBUG=true

# --- Database ---------------------------------------------------------------
# MySQL connection string. Format: mysql+pymysql://USER:PASSWORD@HOST:PORT/DBNAME
# NOTE: URL-encode special characters in the password (e.g. @ -> %40).
DATABASE_URL=mysql+pymysql://root:@localhost:3306/book_shop
# Used by the test-suite. Falls back to an in-memory SQLite DB when unset.
TEST_DATABASE_URL=

# --- Security ----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- CORS / URLs -------------------------------------------------------------
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# --- Email (SMTP) ------------------------------------------------------------
# When EMAIL_ENABLED=false (default for development) emails are not sent;
# every attempt is recorded in the `email_logs` table instead.
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=ShelfSpace <no-reply@shelfspace.local>

# --- Store defaults (overridable at runtime from the admin panel) -----------
DEFAULT_CURRENCY=INR
DEFAULT_TAX_PERCENT=0
DEFAULT_SHIPPING_FEE=0
DEFAULT_FREE_SHIPPING_THRESHOLD=0
DEFAULT_RETURN_WINDOW_DAYS=14
DEFAULT_LOW_STOCK_THRESHOLD=5

# --- Media -------------------------------------------------------------------
MEDIA_DIR=media

# --- Background workers ------------------------------------------------------
# Send queued emails from a worker thread (disable during tests).
EMAIL_WORKER_ENABLED=true
